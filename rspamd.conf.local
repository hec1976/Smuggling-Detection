html_smuggling {
  enabled = true;
  debug = false;
  test_mode = false;

  score_debug = false;
  log_simple_line = true;
  log_score_threshold = 6.0;
  slow_log_ms = 150.0;

  deep_scan_newsletter_header = false;

  auth_mul_enabled = true;
  critical_boost = 1.5;
  min_score = 0.0;
  max_final_score = 14.0;

  redact_log_fields = true;
  require_script_context_for_external = true;
  require_strong_gate_for_decode = true;
