# HTML Smuggling & Attachment Vector Detection Configuration
# Optimized for Version 4.3.7+
# Location: /etc/rspamd/local.d/html_smuggling.conf

html_smuggling {
    # ========================================
    # 1. CORE SCORING (Globale Limits)
    # ========================================
    max_final_score = 12.0;
    soft_only_cap = 4.0;      # Deckelt den Score, wenn nur JS/Heuristiken ohne harten Payload gefunden wurden
    min_score = 0.5;          # Mindest-Score bei Funden
    critical_boost = 0.0;     # Nicht nötig, da CRITICAL-Gewichte bereits hoch sind

    # ========================================
    # 2. NEWSLETTER KONTROLLE (Dämpfung)
    # ========================================
    heur_mul_newsletter_header = 0.4;
    heur_mul_newsletter_heuristic = 0.5;
    heur_mul_trusted_newsletter = 0.15;
    
    # Pfade zu den Maps (Dateien müssen existieren, können aber leer sein)
    trusted_newsletter_domains_map = "/etc/rspamd/local.d/maps.d/trusted_nl.map";
    safe_script_domains_map = "/etc/rspamd/local.d/maps.d/smuggling_safe.map";
    unsafe_script_domains_map = "/etc/rspamd/local.d/maps.d/smuggling_unsafe.map";
    
    deep_scan_newsletter_header = true;

    # ========================================
    # 3. GEWICHTE (Basiswerte für die Klassen)
    # ========================================
    weights {
        JS_SMUGGLING       = 1.2;
        OBFUSCATION        = 2.5;
        SUSPICIOUS_API     = 0.8;
        EVASION_LOGIC      = 1.5;
        CONTAINER          = 6.5;
        SCRIPT_HARD        = 7.5;
        CRITICAL           = 13.0;
        EXTERNAL_SCRIPT    = 1.0;
        CSS_EXFIL          = 2.0;
        CLICKFIX_LURE      = 1.5;
        WASM_STAGING       = 1.4;
        BLOCKCHAIN_STAGING = 1.2;
        ATTACHMENT_VECTOR  = 1.4;
        CERT_SMUGGLING     = 1.1;
        ROTATION_BONUS     = 0.8;
        GEO_TARGETING      = 0.6;
    }

    # ========================================
    # 4. MODULE KONTROLLE (Kompakt-Ansicht)
    # ========================================
    modules {
        # --- Kern-Module ---
        js_smuggling { enabled = true; info_only = false; }
        obfuscation { enabled = true; info_only = false; }
        decoded_payload { enabled = true; info_only = false; }
        uint8array { enabled = true; info_only = false; }
        appinstaller { enabled = true; info_only = false; }

        # --- Angriffs-Vektoren ---
        attachment_vectors { enabled = true; info_only = false; }
        clickfix { enabled = true; info_only = false; }
        wasm_staging { enabled = true; info_only = false; }
        blockchain_staging { enabled = true; info_only = false; }
        css_code_execution { enabled = true; info_only = false; }
        certificate_smuggling { enabled = true; info_only = false; }
        external_scripts { enabled = true; info_only = false; }

        # --- Verhaltens-Analysen ---
        evasion { enabled = true; info_only = false; }
        geo_targeting { enabled = true; info_only = false; }
        persistence { enabled = true; info_only = false; }
        domain_rotation { enabled = true; info_only = false; }
        css_exfil { enabled = true; info_only = false; }

        # --- Spezial-Analysen & Info-Module ---
        push_abuse { enabled = true; info_only = true; }
        image_smuggling_info { enabled = true; info_only = true; }
        wasm_binary_analysis { enabled = true; info_only = false; }
        rc4_detection { enabled = false; }
        link_analysis { enabled = false; info_only = true; }
    }

    # ========================================
    # 5. PERFORMANCE LIMITS
    # ========================================
    limits {
        scan {
            max_bytes = 250 * 1024;
            smart_chunk = 60 * 1024;
            max_attachment_text = 300 * 1024;
        }
        script {
            max_script_time_ms = 80.0;
            max_total_script_scan = 150 * 1024;
            max_check = 3;
            max_external = 5;
        }
        b64 {
            min_len = 200;
            max_candidates = 6;
            min_decode_total = 1500;
        }
    }

    # ========================================
    # 6. LOGGING & DEBUG
    # ========================================
    debug = false;
    score_debug = false;
    log_score_threshold = 6.0;
    slow_log_ms = 200.0;
    force_extended_log = true;
    force_extended_log_min_score = 6.0;
    redact_log_fields = true;
    log_config_validation = true;

    # ========================================
    # 7. SICHERHEIT & INTERNALS
    # ========================================
    require_script_context_for_external = true;
    require_strong_gate_for_decode = true;
    safe_task_access = true;
    safe_part_access = true;
    hard_fail_on_bad_config = false;
    strict_weight_validation = false;
}
