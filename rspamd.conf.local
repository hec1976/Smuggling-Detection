  max_external_reported = 3;
  soft_only_score_cap = 4.5;

  heur_mul_default = 1.0;
  heur_mul_newsletter_header = 0.20;
  heur_mul_newsletter_heuristic = 0.35;
  heur_mul_trusted_newsletter = 0.10;
}
